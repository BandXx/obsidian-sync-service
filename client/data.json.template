  "syncOnlyRegEx": "",
  "syncInternalFilesIgnorePatterns": "\\/obsidian-livesync\\/",
  "writeDocumentsIfConflicted": true,
  "syncOnSave": true,
  "syncOnStart": true,
  "periodicReplication": true,
  "syncInterval": 300,
  "useAdvancedMode": true,
  "displayLanguage": "zh"
