{
  "_说明": "把本文件改名为 data.json，放到 <vault>/.obsidian/plugins/obsidian-livesync/data.json。插件首次启动会把它迁移成加密格式，口令框留空即可。",
  "remoteType": "",
  "couchDB_URI": "https://YOUR_DOMAIN/couch",
  "couchDB_DBNAME": "obsidiannotes",
  "couchDB_USER": "YOUR_USER",
  "couchDB_PASSWORD": "YOUR_PASSWORD",
